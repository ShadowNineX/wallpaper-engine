{
  "name": "wallpaper-engine",
  "type": "module",
  "version": "1.3.0",
  "description": "TypeScript types, Vite plugin, and runtime helpers for Wallpaper Engine web wallpapers",
  "author": "ShadowNineX",
  "license": "MIT",
  "homepage": "https://github.com/ShadowNineX/wallpaper-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShadowNineX/wallpaper-engine.git"
  },
  "bugs": {
    "url": "https://github.com/ShadowNineX/wallpaper-engine/issues"
  },
  "keywords": [
    "wallpaper-engine",
    "wallpaper engine",
    "web wallpaper",
    "vite plugin",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js",
      "require": "./dist/helpers.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "build:lib": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "bun run --cwd ../.. build && node -e \"require('fs').copyFileSync('../../README.md', 'README.md')\""
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "colorjs.io": "^0.7.1",
    "fast-average-color": "^9.5.2",
    "tsdown": "^0.22.14",
    "vite": "^8.2.0",
    "vitest": "^4.1.6"
  }
}
