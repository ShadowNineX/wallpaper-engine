    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "unplugin-fonts": "^2.0.0",
    "unplugin-icons": "^23.0.1",
