<section
  class="property-playground not-content"
  data-property-playground
  style="--preview-accent: #60a5fa; --preview-intensity: 0.5;"
  aria-labelledby="property-playground-title"
>
  <div class="playground-copy">
    <h2 id="property-playground-title">Make it yours</h2>
    <p>
      Pick a color, tune the intensity, and toggle the title. The project below
      starts with these same defaults.
    </p>
  </div>

  <div class="playground-layout">
    <form class="property-controls" data-property-controls>
      <fieldset>
        <legend>Wallpaper properties</legend>

        <label class="control-row color-control">
          <span>
            <strong>Accent</strong>
            <small>Background color</small>
          </span>
          <span class="color-input-wrap">
            <input
              id="playground-accent"
              type="color"
              name="accent"
              value="#60a5fa"
              aria-describedby="accent-value"
            />
            <output id="accent-value" for="playground-accent">#60A5FA</output>
          </span>
        </label>

        <label class="control-row range-control">
          <span>
            <strong>Intensity</strong>
            <small>Title opacity</small>
          </span>
          <span class="range-input-wrap">
            <input
              id="playground-intensity"
              type="range"
              name="intensity"
              min="0"
              max="1"
              step="0.01"
              value="0.5"
              aria-describedby="intensity-value"
            />
            <output id="intensity-value" for="playground-intensity">0.50</output>
          </span>
        </label>

        <label class="control-row checkbox-control">
          <span>
            <strong>Show title</strong>
            <small>Toggle the heading</small>
          </span>
          <input id="playground-show-title" type="checkbox" name="showTitle" checked />
        </label>
      </fieldset>

      <button type="reset">Reset defaults</button>
    </form>

    <div class="wallpaper-preview" aria-label="Wallpaper result preview">
      <h3 data-preview-title>My Wallpaper</h3>
    </div>
  </div>
</section>

<script>
  const DEFAULTS = {
    accent: '#60a5fa',
    intensity: 0.5,
    showTitle: true,
  } as const;

  function previewInk(accent: string): string {
    const rgb = Number.parseInt(accent.slice(1), 16);
    const [red = 0, green = 0, blue = 0] = [16, 8, 0].map((shift) => {
      const channel = ((rgb >> shift) & 255) / 255;
      return channel <= 0.04045 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
    });
    return red * 0.2126 + green * 0.7152 + blue * 0.0722 > 0.18 ? '#08111f' : '#f8fafc';
  }

  for (const playground of document.querySelectorAll<HTMLElement>('[data-property-playground]')) {
    const form = playground.querySelector<HTMLFormElement>('[data-property-controls]');
    const accent = form?.elements.namedItem('accent');
    const intensity = form?.elements.namedItem('intensity');
    const showTitle = form?.elements.namedItem('showTitle');
    const accentValue = form?.querySelector<HTMLOutputElement>('#accent-value');
    const intensityValue = form?.querySelector<HTMLOutputElement>('#intensity-value');
    const title = playground.querySelector<HTMLElement>('[data-preview-title]');

    if (
      !(accent instanceof HTMLInputElement)
      || !(intensity instanceof HTMLInputElement)
      || !(showTitle instanceof HTMLInputElement)
      || !accentValue
      || !intensityValue
      || !title
      || !form
    ) {
      continue;
    }

    const render = () => {
      const numericIntensity = Number.parseFloat(intensity.value);
      const safeIntensity = Number.isFinite(numericIntensity)
        ? Math.min(1, Math.max(0, numericIntensity))
        : DEFAULTS.intensity;

      playground.style.setProperty('--preview-accent', accent.value);
      playground.style.setProperty('--preview-ink', previewInk(accent.value));
      playground.style.setProperty('--preview-intensity', String(safeIntensity));
      accentValue.value = accent.value.toUpperCase();
      intensityValue.value = safeIntensity.toFixed(2);
      title.hidden = !showTitle.checked;
    };

    form.addEventListener('input', render);
    form.addEventListener('reset', (event) => {
      event.preventDefault();
      accent.value = DEFAULTS.accent;
      intensity.value = String(DEFAULTS.intensity);
      showTitle.checked = DEFAULTS.showTitle;
      render();
    });
    render();
  }
</script>

<style>
