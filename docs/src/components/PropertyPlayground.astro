    opacity: var(--preview-intensity);
  }

  .wallpaper-preview h3[hidden] {
    display: none;
  }

  @container property-playground (min-width: 44rem) {
    .playground-layout {
      grid-template-columns: minmax(16rem, 0.86fr) minmax(19rem, 1.14fr);
      align-items: stretch;
