    align-self: flex-start;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.7rem;
    background: transparent;
    color: var(--sl-color-white);
    font: 650 0.88rem/1 var(--__sl-font);
    cursor: pointer;
  }

  button:hover {
