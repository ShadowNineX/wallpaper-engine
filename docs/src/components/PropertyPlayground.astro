    font-family: var(--__sl-font-mono);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  input[type='color'] {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.2rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
