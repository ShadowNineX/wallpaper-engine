    margin-top: 1.5rem;
  }

  .property-controls {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 1rem;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    margin-bottom: 0.65rem;
    color: var(--sl-color-gray-3);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .control-row {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }

  .control-row:first-of-type {
    border-top: 1px solid var(--sl-color-hairline-light);
  }

  .control-row > span:first-child {
    display: grid;
    gap: 0.15rem;
  }

  .control-row strong {
    color: var(--sl-color-white);
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .control-row small {
    color: var(--sl-color-gray-3);
    font-size: 0.78rem;
  }

  .color-input-wrap,
  .range-input-wrap {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.75rem;
  }

  output {
